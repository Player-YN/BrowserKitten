{
  "manifest_version": 3,
  "name": "Browser Kitten",
  "version": "1.2.0",
  "description": "An AI assistant in your side panel. It reads, clicks, and fills the pages you are signed in to, and hands back finished work.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "identity",
    "alarms",
    "downloads",
    "offscreen",
    "tabGroups",
    "webNavigation",
    "debugger"
  ],
  "optional_permissions": [
    "userScripts",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Pick content on the page"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Capture a screen region to the clipboard and the chat"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "sandbox": {
    "pages": [
      "src/sandbox/runtime.html",
      "src/sandbox/siteFrame.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/agent/vnext/sessionWorkspace/pickContext.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Open Browser Kitten",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "minimum_chrome_version": "135"
}
